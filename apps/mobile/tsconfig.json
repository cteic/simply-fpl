{
  "extends": "@simplyfpl/tsconfig-config/tsconfig.react-native.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleSuffixes": [".native", ".ios", ".android", ""],
    "paths": {
      "@/*": ["./src/*"]
    },
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", "app.json"]
}
