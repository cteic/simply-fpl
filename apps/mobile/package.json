{
  "name": "@simplyfpl/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo-google-fonts/dm-mono": "^0.2.3",
    "@expo-google-fonts/dm-sans": "^0.2.3",
    "@expo/metro-runtime": "~58.0.17",
    "@simplyfpl/features": "workspace:*",
    "@simplyfpl/fpl-client": "workspace:*",
    "@simplyfpl/i18n": "workspace:*",
    "@simplyfpl/types": "workspace:*",
    "@simplyfpl/ui": "workspace:*",
    "@supabase/supabase-js": "^2.0.0",
    "@tamagui/animations-react-native": "2.4.0",
    "@tanstack/react-query": "^5.0.0",
    "expo": "~58.1.0",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "tamagui": "2.4.0"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "4.7.0",
    "@babel/core": "^7.29.6",
    "@simplyfpl/tsconfig-config": "workspace:*",
    "@types/react": "^19.0.0",
    "babel-preset-expo": "~58.0.26",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
