{
  "cli": {
    "version": ">= 15.0.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://simplyfpl-worker.pete-9c4.workers.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "<<APPLE_ID_EMAIL>>",
        "ascAppId": "<<ASC_APP_ID>>",
        "appleTeamId": "<<APPLE_TEAM_ID>>"
      },
      "android": {
        "serviceAccountKeyPath": "<<PLAY_SERVICE_ACCOUNT_KEY_PATH>>",
        "track": "internal"
      }
    }
  }
}
