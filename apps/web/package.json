{
  "name": "@simplyfpl/web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "clean:tamagui": "rm -rf .tamagui",
    "clean": "rm -rf .tamagui .next",
    "generate-tamagui-css": "node scripts/generate-tamagui-css.mjs",
    "dev": "pnpm run clean:tamagui && pnpm run generate-tamagui-css && next dev",
    "build": "pnpm run clean:tamagui && pnpm run generate-tamagui-css && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --passWithNoTests",
    "budget:check": "node ../../scripts/check-bundle-budget.mjs",
    "capture:hero": "node scripts/capture-hero-screenshot.mjs",
    "e2e": "bddgen --config playwright.config.ts && playwright test --config playwright.config.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "@simplyfpl/features": "workspace:*",
    "@simplyfpl/fpl-client": "workspace:*",
    "@simplyfpl/i18n": "workspace:*",
    "@simplyfpl/types": "workspace:*",
    "@simplyfpl/ui": "workspace:*",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "next": "^15.5.23",
    "posthog-js": "^1.406.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native-web": "^0.21.0",
    "stripe": "^22.2.0",
    "tamagui": "2.4.0"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "4.7.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@simplyfpl/tsconfig-config": "workspace:*",
    "@tamagui/core": "2.4.0",
    "@tamagui/next-plugin": "2.4.0",
    "@tamagui/web": "2.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6",
    "wrangler": "^4.108.0"
  }
}
