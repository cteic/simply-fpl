{
  "name": "@simplyfpl/web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "ensure-tamagui-css": "node -e \"const f=require('fs');f.mkdirSync('public',{recursive:true});f.closeSync(f.openSync('public/tamagui.css','a'))\"",
    "dev": "pnpm run ensure-tamagui-css && next dev",
    "build": "pnpm run ensure-tamagui-css && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --passWithNoTests",
    "budget:check": "node ../../scripts/check-bundle-budget.mjs",
    "e2e": "bddgen --config playwright.config.ts && playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@simplyfpl/features": "workspace:*",
    "@simplyfpl/fpl-client": "workspace:*",
    "@simplyfpl/types": "workspace:*",
    "@simplyfpl/ui": "workspace:*",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "next": "~15.4.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native-web": "^0.21.0",
    "tamagui": "2.0.0-rc.42"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@simplyfpl/tsconfig-config": "workspace:*",
    "@tamagui/core": "2.0.0-rc.42",
    "@tamagui/next-plugin": "2.0.0-rc.42",
    "@tamagui/web": "2.0.0-rc.42",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.86.0"
  }
}
