# Cloudflare Worker URL (your FPL proxy)
NEXT_PUBLIC_API_URL=http://localhost:8787

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Web Analytics (optional)
# Grab from dash.cloudflare.com → Analytics & Logs → Web Analytics → your site → JS snippet → "token"
# NEXT_PUBLIC_CF_BEACON_TOKEN=your-beacon-token

# PostHog — product analytics + session replay + error tracking (optional, EU instance).
# Sign up at posthog.com/eu → Project Settings → Project API Key (phc_...).
# App runs fully without these vars — PostHog is dormant until consent AND a key is present.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Server-side salt for SHA-256(salt+user_id) → PostHog distinct_id. Keep secret.
# Generate with: openssl rand -hex 32
POSTHOG_HASH_SALT=

# Feature flags — set to 'true' (string) to enable, anything else = disabled.
# All flags default OFF in production to match the launch scope (live rank +
# leagues/rivals only). Flip ON locally in .env.local to work on hidden surfaces.
NEXT_PUBLIC_FEATURE_AUTH=false
NEXT_PUBLIC_FEATURE_PRICES=false
NEXT_PUBLIC_FEATURE_PLANNER=false
NEXT_PUBLIC_FEATURE_ADS=false
# Set to 'true' locally to visualise reserved ad slots as transparent spacers (dev/staging only)
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=false

# Frank AI coach (on-demand queries — Ultimate tier)
# Flip NEXT_PUBLIC_FEATURE_FRANK_ONDEMAND to 'true' locally to surface the Ask Frank form.
NEXT_PUBLIC_FEATURE_FRANK_ONDEMAND=true
# Server-side counterpart — route.ts checks this independently of the client flag.
FEATURE_FRANK_ONDEMAND=true
# Anthropic API key — required for Frank on-demand and the weekly cron.
ANTHROPIC_API_KEY=
# Worker base URL used by server-side routes (not NEXT_PUBLIC — not needed in browser).
API_URL=http://localhost:8787
# Comma-separated list of emails allowed to access /admin/frank.
FRANK_ADMIN_EMAILS=

# Stripe — server-only (never expose STRIPE_SECRET_KEY to client)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Stripe Dashboard → Products
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_PRO_LIFETIME=price_...
STRIPE_PRICE_ULTIMATE_MONTHLY=price_...
STRIPE_PRICE_ULTIMATE_YEARLY=price_...
STRIPE_PRICE_ULTIMATE_LIFETIME=price_...
