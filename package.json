{
  "name": "simplyfpl-mono",
  "author": "SimplyFPL",
  "description": "SimplyFPL monorepo — FPL companion app",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@simplyfpl/web",
    "build:mobile": "turbo run build --filter=@simplyfpl/mobile",
    "build:worker": "turbo run build --filter=@simplyfpl/worker",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "build:watch": "turbo run build:watch",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@simplyfpl/web",
    "dev:mobile": "turbo run dev --filter=@simplyfpl/mobile",
    "dev:worker": "turbo run dev --filter=@simplyfpl/worker",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yaml,yml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yaml,yml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "turbo run lint && node scripts/check-hardcoded-strings.mjs",
    "lint:fix": "turbo run lint:fix",
    "check:pii": "node scripts/check-posthog-pii.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:headless": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "measure:rank-accuracy": "node scripts/measure-rank-accuracy.mjs",
    "clean": "git clean -dfX",
    "install:clean": "rm -rf \"**/node_modules\" && pnpm -r clean",
    "install:fresh": "pnpm install:clean && pnpm i",
    "prepare": "husky",
    "check:all": "turbo run check:all"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.59.1",
    "@simplyfpl/eslint-config": "workspace:*",
    "@simplyfpl/prettier-config": "workspace:*",
    "@simplyfpl/tsconfig-config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "playwright-bdd": "^8.5.1",
    "prettier": "^3.5.1",
    "turbo": "^2.9.14",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "react-native-web": "^0.21.0",
      "uuid": ">=11.1.1",
      "ws": ">=8.21.0",
      "fast-uri": "^4.1.4",
      "shell-quote": "^1.11.0",
      "undici": "^7.30.1",
      "@babel/core": "^7.29.6",
      "vitest": "^3.2.6",
      "js-yaml": "^5.2.2",
      "dompurify": "^3.4.17",
      "protobufjs": ">=7.6.3",
      "piscina": "^5.3.2",
      "body-parser": "^2.4.0",
      "proxy-addr": "^2.0.8",
      "compression": "^1.8.2",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.6",
      "brace-expansion@5": "^5.0.11",
      "browserslist": "^4.28.7",
      "form-data@3": "^3.0.5",
      "ip-address": "^10.3.1",
      "nanoid@3": "^3.3.18",
      "node-forge": "^1.4.1",
      "postcss": "^8.5.18",
      "source-map-js": "^1.2.2",
      "vite@7": "^7.3.7",
      "@xmldom/xmldom@0.9": "^0.9.12"
    },
    "patchedDependencies": {
      "tamagui-loader@2.4.0": "patches/tamagui-loader@2.4.0.patch",
      "@tamagui/next-plugin@2.4.0": "patches/@tamagui__next-plugin@2.4.0.patch",
      "@tamagui/web@2.4.0": "patches/@tamagui__web@2.4.0.patch"
    }
  }
}
